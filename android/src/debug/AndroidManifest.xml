<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <instrumentation android:name="org.kde.kdeconnect.CodecFailureInstrumentation"
        android:targetPackage="org.kde.kdeconnect_tp.debug" />
    <application>
        <activity android:name="org.kde.kdeconnect.CodecFailureProofActivity"
            android:screenOrientation="landscape" android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity
            android:name="org.kde.kdeconnect.QuitActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <activity android:name="org.kde.kdeconnect.PanelProofActivity"
            android:screenOrientation="landscape" android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
        <activity android:name="org.kde.kdeconnect.WaitingProofActivity"
            android:screenOrientation="landscape" android:exported="false"
            android:theme="@style/Theme.AppCompat.NoActionBar" />
    </application>

</manifest>
