+package com.freerdp.freerdpcore.utils;
+
+/**
+ * Converts touch deltas into a bounded absolute RDP cursor position.
+ *
+ * RDP pointer PDUs use absolute coordinates, while KDE Connect's Remote Input UI behaves like a
+ * relative touchpad. This class bridges the two models and intentionally mirrors Remote Input's
+ * DPI normalization, sensitivity steps, and speed-based polynomial acceleration profiles.
+ */
+public final class TouchpadPointerController
+{
+	private static final float STANDARD_DPI = 240.0f;
+
+	private int width = 1;
+	private int height = 1;
+	private int x;
+	private int y;
+	private boolean positionInitialized;
+	private float dpiMultiplier = 1.0f;
+	private float sensitivity = 1.0f;
+	private AccelerationProfile accelerationProfile = new PolynomialProfile(1.0f);
+	private String accelerationProfileName = "medium";
+
+	public void setBounds(int width, int height)
+	{
+		this.width = Math.max(1, width);
+		this.height = Math.max(1, height);
+		if (!positionInitialized)
+		{
+			x = this.width / 2;
+			y = this.height / 2;
+			positionInitialized = true;
+		}
+		else
+			setPosition(x, y);
+	}
+
+	public void configure(float displayDpi, String sensitivityName, String profileName)
+	{
+		dpiMultiplier = displayDpi > 0 ? STANDARD_DPI / displayDpi : 1.0f;
+		sensitivity = sensitivityForName(sensitivityName);
+
+		String normalizedProfile = profileName == null ? "medium" : profileName;
+		if (!normalizedProfile.equals(accelerationProfileName))
+		{
+			accelerationProfileName = normalizedProfile;
+			accelerationProfile = createAccelerationProfile(normalizedProfile);
+		}
+	}
+
+	public Position moveBy(float touchDeltaX, float touchDeltaY, long eventTime)
+	{
+		float normalizedX = touchDeltaX * dpiMultiplier * sensitivity;
+		float normalizedY = touchDeltaY * dpiMultiplier * sensitivity;
+		accelerationProfile.touchMoved(normalizedX, normalizedY, eventTime);
+		Position delta = accelerationProfile.commit();
+		setPosition(x + delta.x, y + delta.y);
+		return getPosition();
+	}
+
+	public void setPosition(int x, int y)
+	{
+		this.x = Math.max(0, Math.min(width - 1, x));
+		this.y = Math.max(0, Math.min(height - 1, y));
+		positionInitialized = true;
+	}
+
+	public Position getPosition()
+	{
+		return new Position(x, y);
+	}
+
+	private static float sensitivityForName(String name)
+	{
+		if ("slowest".equals(name))
+			return 0.2f;
+		if ("aboveSlowest".equals(name))
+			return 0.5f;
+		if ("aboveDefault".equals(name))
+			return 1.5f;
+		if ("fastest".equals(name))
+			return 2.0f;
+		return 1.0f;
+	}
+
+	private static AccelerationProfile createAccelerationProfile(String name)
+	{
+		switch (name)
+		{
+			case "weaker":
+				return new PolynomialProfile(0.25f);
+			case "weak":
+				return new PolynomialProfile(0.5f);
+			case "medium":
+				return new PolynomialProfile(1.0f);
+			case "strong":
+				return new PolynomialProfile(1.5f);
+			case "stronger":
+				return new PolynomialProfile(2.0f);
+			case "noacceleration":
+			default:
+				return new DefaultProfile();
+		}
+	}
+
+	public static final class Position
+	{
+		public final int x;
+		public final int y;
+
+		public Position(int x, int y)
+		{
+			this.x = x;
+			this.y = y;
+		}
+	}
+
+	private interface AccelerationProfile
+	{
+		void touchMoved(float deltaX, float deltaY, long eventTime);
+
+		Position commit();
+	}
+
+	private static final class DefaultProfile implements AccelerationProfile
+	{
+		private float accumulatedX;
+		private float accumulatedY;
+
+		@Override public void touchMoved(float deltaX, float deltaY, long eventTime)
+		{
+			accumulatedX += deltaX;
+			accumulatedY += deltaY;
+		}
+
+		@Override public Position commit()
+		{
+			int deltaX = (int)accumulatedX;
+			int deltaY = (int)accumulatedY;
+			accumulatedX %= 1.0f;
+			accumulatedY %= 1.0f;
+			return new Position(deltaX, deltaY);
+		}
+	}
+
+	private static final class PolynomialProfile implements AccelerationProfile
+	{
+		private static final int HISTORY_SIZE = 32;
+		private static final long FRESH_THRESHOLD_MS = 150;
+
+		private final float exponent;
+		private final TouchDeltaEvent[] history = new TouchDeltaEvent[HISTORY_SIZE];
+		private float accumulatedX;
+		private float accumulatedY;
+
+		private PolynomialProfile(float exponent)
+		{
+			this.exponent = exponent;
+		}
+
+		@Override public void touchMoved(float deltaX, float deltaY, long eventTime)
+		{
+			float multiplier = multiplierFromHistory(eventTime);
+			accumulatedX += deltaX * multiplier;
+			accumulatedY += deltaY * multiplier;
+			System.arraycopy(history, 0, history, 1, history.length - 1);
+			history[0] = new TouchDeltaEvent(deltaX, deltaY, eventTime);
+		}
+
+		private float multiplierFromHistory(long eventTime)
+		{
+			float distanceMoved = 0;
+			long deltaTime = 0;
+			for (TouchDeltaEvent event : history)
+			{
+				if (event == null || eventTime - event.time > FRESH_THRESHOLD_MS)
+					break;
+				distanceMoved += Math.hypot(event.x, event.y);
+				deltaTime = eventTime - event.time;
+			}
+
+			if (deltaTime == 0)
+				return 0.01f;
+			float speed = distanceMoved / (deltaTime / 1000.0f);
+			return Math.max(0.01f, (float)Math.pow(speed / 600.0f, exponent));
+		}
+
+		@Override public Position commit()
+		{
+			int deltaX = (int)accumulatedX;
+			int deltaY = (int)accumulatedY;
+			accumulatedX %= 1.0f;
+			accumulatedY %= 1.0f;
+			return new Position(deltaX, deltaY);
+		}
+
+		private static final class TouchDeltaEvent
+		{
+			private final float x;
+			private final float y;
+			private final long time;
+
+			private TouchDeltaEvent(float x, float y, long time)
+			{
+				this.x = x;
+				this.y = y;
+				this.time = time;
+			}
+		}
+	}
+}
