+#if defined(HEADSET_TIMING)
+#include <time.h>
+static UINT64 headset_clock_ns(void)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return (UINT64)now.tv_sec * 1000000000ULL + now.tv_nsec;
+}
+#define HEADSET_STAGE(stage, id) WLog_Print(WLog_Get("HeadsetStage"), WLOG_INFO, "stage=%s ns=%" PRIu64 " id=%" PRIu64, stage, headset_clock_ns(), (UINT64)(id))
+#else
+#define HEADSET_STAGE(stage, id) do { } while (0)
+#endif
