From f3f4db519371ce90243438a47cdf9de7f3e5778f Mon Sep 17 00:00:00 2001
From: Fabian Druschke <fdruschke@outlook.com>
Date: Fri, 10 Jul 2026 23:54:52 +0200
Subject: [PATCH 4/9] android: keep optional UI events from aborting sessions

---
 .../freeRDPCore/src/main/cpp/android_event.c  | 103 +++++++++++++-----
 .../freeRDPCore/src/main/cpp/android_event.h  |   6 +-
 .../src/main/cpp/android_freerdp.c            |  27 ++++-
 .../src/main/cpp/android_freerdp.h            |   1 +
 .../presentation/SessionActivity.java         |  32 ++++--
 5 files changed, 126 insertions(+), 43 deletions(-)

diff --git a/client/Android/Studio/freeRDPCore/src/main/cpp/android_event.c b/client/Android/Studio/freeRDPCore/src/main/cpp/android_event.c
index ae8aa24..e090f4e 100644
--- a/client/Android/Studio/freeRDPCore/src/main/cpp/android_event.c
+++ b/client/Android/Studio/freeRDPCore/src/main/cpp/android_event.c
@@ -24,58 +24,72 @@
 
 BOOL android_push_event(freerdp* inst, ANDROID_EVENT* event)
 {
+	if (!inst || !inst->context || !event)
+		return FALSE;
+
 	androidContext* aCtx = (androidContext*)inst->context;
+	ANDROID_EVENT_QUEUE* queue = aCtx->event_queue;
+	if (!queue || !queue->isSet)
+		return FALSE;
 
-	if (aCtx->event_queue->count >= aCtx->event_queue->size)
+	EnterCriticalSection(&queue->lock);
+
+	if (queue->count >= queue->size)
 	{
-		size_t new_size = aCtx->event_queue->size;
+		size_t new_size = queue->size;
 		do
 		{
 			if (new_size >= SIZE_MAX - 128ull)
+			{
+				LeaveCriticalSection(&queue->lock);
 				return FALSE;
+			}
 
 			new_size += 128ull;
-		} while (new_size <= aCtx->event_queue->count);
+		} while (new_size <= queue->count);
 		void* new_events =
-		    realloc((void*)aCtx->event_queue->events, sizeof(ANDROID_EVENT*) * new_size);
+		    realloc((void*)queue->events, sizeof(ANDROID_EVENT*) * new_size);
 
 		if (!new_events)
+		{
+			LeaveCriticalSection(&queue->lock);
 			return FALSE;
+		}
 
-		aCtx->event_queue->events = new_events;
-		aCtx->event_queue->size = new_size;
+		queue->events = new_events;
+		queue->size = new_size;
 	}
 
-	aCtx->event_queue->events[(aCtx->event_queue->count)++] = event;
-	return SetEvent(aCtx->event_queue->isSet);
-}
-
-static ANDROID_EVENT* android_peek_event(ANDROID_EVENT_QUEUE* queue)
-{
-	ANDROID_EVENT* event;
-
-	if (queue->count < 1)
-		return nullptr;
-
-	event = queue->events[0];
-	return event;
+	queue->events[queue->count++] = event;
+	const BOOL rc = SetEvent(queue->isSet);
+	if (!rc)
+	{
+		queue->count--;
+		queue->events[queue->count] = nullptr;
+	}
+	LeaveCriticalSection(&queue->lock);
+	return rc;
 }
 
 static ANDROID_EVENT* android_pop_event(ANDROID_EVENT_QUEUE* queue)
 {
-	ANDROID_EVENT* event;
+	WINPR_ASSERT(queue);
+	EnterCriticalSection(&queue->lock);
 
 	if (queue->count < 1)
+	{
+		LeaveCriticalSection(&queue->lock);
 		return nullptr;
+	}
 
-	event = queue->events[0];
+	ANDROID_EVENT* event = queue->events[0];
 	(queue->count)--;
 
 	for (size_t i = 0; i < queue->count; i++)
-	{
 		queue->events[i] = queue->events[i + 1];
-	}
+	queue->events[queue->count] = nullptr;
 
+	LeaveCriticalSection(&queue->lock);
 	return event;
 }
 
@@ -89,15 +103,14 @@ static BOOL android_process_event(ANDROID_EVENT_QUEUE* queue, freerdp* inst)
 	context = inst->context;
 	WINPR_ASSERT(context);
 
-	while (android_peek_event(queue))
+	ANDROID_EVENT* event = nullptr;
+	while ((event = android_pop_event(queue)) != nullptr)
 	{
-		BOOL rc = FALSE;
+		BOOL rc = TRUE;
 		androidContext* afc = (androidContext*)context;
-		ANDROID_EVENT* event = android_pop_event(queue);
-
-		WINPR_ASSERT(event);
+		const int eventType = event->type;
 
-		switch (event->type)
+		switch (eventType)
 		{
 			case EVENT_TYPE_KEY:
 			{
@@ -128,6 +141,12 @@ static BOOL android_process_event(ANDROID_EVENT_QUEUE* queue, freerdp* inst)
 
 			case EVENT_TYPE_CLIPBOARD:
 			{
+				if (!afc->clipboard || !afc->cliprdr)
+				{
+					WLog_DBG(TAG, "Dropping clipboard event because clipboard redirection is disabled");
+					break;
+				}
+
 				ANDROID_EVENT_CLIPBOARD* clipboard_event = (ANDROID_EVENT_CLIPBOARD*)event;
 				const char* mimeType = clipboard_event->mimeType;
 				UINT32 formatId = ClipboardRegisterFormat(afc->clipboard, mimeType);
@@ -143,14 +162,33 @@ static BOOL android_process_event(ANDROID_EVENT_QUEUE* queue, freerdp* inst)
 			break;
 
 			case EVENT_TYPE_DISCONNECT:
+				afc->disconnect_requested = TRUE;
+				WLog_DBG(TAG, "Processing requested Android disconnect");
+				break;
+
 			default:
+				rc = FALSE;
 				break;
 		}
 
 		android_event_free(event);
 
 		if (!rc)
+		{
+			/* Input and clipboard events are auxiliary to the RDP transport. A rejected
+			 * event must not tear down an otherwise healthy desktop session; transport
+			 * failures are reported by freerdp_check_event_handles(). */
+			if (eventType == EVENT_TYPE_KEY || eventType == EVENT_TYPE_KEY_UNICODE ||
+			    eventType == EVENT_TYPE_CURSOR || eventType == EVENT_TYPE_CLIPBOARD)
+			{
+				WLog_WARN(TAG, "Android event type %d was rejected; keeping the RDP session alive",
+				          eventType);
+				continue;
+			}
+
+			WLog_ERR(TAG, "Unknown Android event type %d", eventType);
 			return FALSE;
+		}
 	}
 
 	return TRUE;
@@ -331,10 +369,12 @@ BOOL android_event_queue_init(freerdp* inst)
 
 	queue->size = 16;
 	queue->count = 0;
+	InitializeCriticalSection(&queue->lock);
 	queue->isSet = CreateEventA(nullptr, TRUE, FALSE, nullptr);
 
 	if (!queue->isSet)
 	{
+		DeleteCriticalSection(&queue->lock);
 		free(queue);
 		return FALSE;
 	}
@@ -345,6 +385,7 @@ BOOL android_event_queue_init(freerdp* inst)
 	{
 		WLog_ERR(TAG, "android_event_queue_init: memory allocation failed");
 		(void)CloseHandle(queue->isSet);
+		DeleteCriticalSection(&queue->lock);
 		free(queue);
 		return FALSE;
 	}
@@ -374,13 +415,17 @@ void android_event_queue_uninit(freerdp* inst)
 
 		if (queue->events)
 		{
+			for (size_t i = 0; i < queue->count; i++)
+				android_event_free(queue->events[i]);
 			free(queue->events);
 			queue->events = nullptr;
 			queue->size = 0;
 			queue->count = 0;
 		}
 
+		DeleteCriticalSection(&queue->lock);
 		free(queue);
+		aCtx->event_queue = nullptr;
 	}
 }
 
