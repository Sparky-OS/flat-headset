+	private boolean isClipboardRedirectionEnabled()
+	{
+		if (session == null)
+			return false;
+
+		Uri openUri = session.getOpenUri();
+		if (openUri == null)
+			return true; // Saved bookmarks explicitly enable /clipboard.
+
+		String clipboard = openUri.getQueryParameter("clipboard");
+		return clipboard != null && !"-".equals(clipboard);
+	}
+
