+package com.freerdp.freerdpcore.utils;
+
+/**
+ * Converts touch deltas into a bounded absolute RDP cursor position.
+ *
+ * RDP pointer PDUs use absolute coordinates, while KDE Connect's Remote Input UI behaves like a
+ * relative touchpad. This class bridges the two models and intentionally mirrors Remote Input's
+ * DPI normalization, sensitivity steps, and speed-based polynomial acceleration profiles.
+ */
+public final class TouchpadPointerController
+{
+	private static final float STANDARD_DPI = 240.0f;
+
+	private int width = 1;
+	private int height = 1;
+	private int x;
+	private int y;
+	private boolean positionInitialized;
+	private float dpiMultiplier = 1.0f;
+	private float sensitivity = 1.0f;
+	private AccelerationProfile accelerationProfile = new PolynomialProfile(1.0f);
+	private String accelerationProfileName = "medium";
+
