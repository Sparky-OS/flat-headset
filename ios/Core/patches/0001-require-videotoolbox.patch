+{
+	if (!h264 || h264->Compressor)
+		return FALSE;
+	if (h264->softwareDecoding)
+		return TRUE;
+	if (!h264->softwarePermission ||
+	    !h264->softwarePermission(h264->softwarePermissionUser, reason))
+		return FALSE;
+	h264->softwareDecoding = TRUE;
+	return TRUE;
